generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Platform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  X
  SNAPCHAT
  FACEBOOK
  LINKEDIN
  TWITCH
  OTHER
}

enum DealType {
  FIXED_BUDGET
  COMMISSION
  BARTER
}

enum Currency {
  EGP
  USD
  EUR
}

enum DeliverableStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REVISION_REQUESTED
}

enum GiftApprovalRole {
  NONE
  MANAGER
  ADMIN
}

enum CreditTransactionType {
  CREDIT
  DEBIT
}

enum ActivityKind {
  MANUAL
  SYSTEM
}

enum ActivityType {
  CALL
  DM
  EMAIL
  MEETING
  NOTE
  STAGE_CHANGED
  OWNERSHIP_CHANGED
  GIFT_REQUESTED
  GIFT_APPROVED
  GIFT_REJECTED
  GIFT_DISPATCHED
  GIFT_DELIVERED
  DELIVERABLE_SUBMITTED
  DELIVERABLE_APPROVED
  DELIVERABLE_REVISION_REQUESTED
  ENGAGEMENT_CREATED
  ENGAGEMENT_COMPLETED
  CREATOR_CREATED
  CREATOR_UPDATED
  CREATOR_APPROVED
  CREATOR_REJECTED
  REQUEST_CREATED
  REQUEST_RESOLVED
}

enum ApprovalStatus {
  PENDING
  REJECTED
}

enum AvailRequestStatus {
  PENDING_PRE_APPROVAL
  PENDING_RELEASE
  APPROVED
  REJECTED
}

enum NotificationType {
  SYSTEM
  DELIVERABLE_OVERDUE
  DELIVERABLE_SUBMITTED
  DELIVERABLE_APPROVED
  DELIVERABLE_REVISION_REQUESTED
  GIFT_EXCEPTION_REQUESTED
  GIFT_DISPATCHED
  GIFT_DELIVERED
  GIFT_APPROVED
  GIFT_REJECTED
  AVAILABILITY_REQUESTED
  AVAILABILITY_APPROVED
  AVAILABILITY_REJECTED
  ACTIVITY_MENTION
}

// ---------------------------------------------------------------------------
// Users, Roles, Permissions, Teams
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  phone        String?  @unique
  passwordHash String
  displayName  String
  avatarUrl    String?
  roleId       String
  teamId       String
  archivedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role   Role @relation(fields: [roleId], references: [id])
  team   Team @relation(fields: [teamId], references: [id])

  transactionLogs       TransactionLog[]
  ownerships            CreatorOwnership[]
  requestedRequests     AvailabilityRequest[] @relation("Requester")
  preApprovedRequests   AvailabilityRequest[] @relation("PreApprover")
  releasedRequests      AvailabilityRequest[] @relation("ReleaseApprover")
  rejectedRequests      AvailabilityRequest[] @relation("RequestRejector")
  notifications         Notification[]
  authoredActivityLogs  ActivityLog[]        @relation("ActivityAuthor")
  submittedDeliverables Deliverable[]        @relation("DeliverableSubmitter")
  reviewedDeliverables  Deliverable[]        @relation("DeliverableReviewer")
  requestedGifts        Gift[]               @relation("GiftRequester")
  approvedGifts         Gift[]               @relation("GiftApprover")
  creditAccount         CreditAccount? 
  createdEngagements    Engagement[]         @relation("EngagementCreator")
  createdCreators       Creator[]            @relation("CreatorCreator")
  reviewedCreators      Creator[]            @relation("CreatorReviewer")
}

model Role {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  immutable   Boolean  @default(false)
  createdAt   DateTime @default(now())

  users       User[]
  permissions Permission[]
}

model Permission {
  id     String @id @default(cuid())
  action String @unique

  roles Role[]
}

model Team {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  users                User[]
  pipelineConfigs      PipelineConfig[]
  creatorOwnerships    CreatorOwnership[]
  engagements          Engagement[]
  requestedRequests    AvailabilityRequest[] @relation("RequestingTeam")
  owningRequests       AvailabilityRequest[] @relation("OwningTeam")
}

model TransactionLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String?
  entityId   String?
  detail     String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model CreditAccount {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Float    @default(0)
  updatedAt DateTime @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]

  @@index([userId])
}

model CreditTransaction {
  id        String                @id @default(cuid())
  accountId String
  amount    Float
  type      CreditTransactionType
  reason    String
  refType   String
  refId     String
  createdAt DateTime              @default(now())

  account CreditAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
}

// ---------------------------------------------------------------------------
// Reference data (admin-managed)
// ---------------------------------------------------------------------------

model Country {
  id          String   @id @default(cuid())
  name        String   @unique
  dialCode    String
  phoneDigits Int?
  createdAt   DateTime @default(now())

  cities   City[]
  creators Creator[]
}

model City {
  id        String   @id @default(cuid())
  name      String
  countryId String
  createdAt DateTime @default(now())

  country  Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  creators Creator[]

  @@unique([countryId, name])
}

model CreatorType {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  creators Creator[]
}

// Admin-maintained definitions of creator fields. System rows (key != null)
// map to built-in fields and cannot be deleted; custom rows are admin-defined.
model CreatorField {
  id        String   @id @default(cuid())
  key       String?  @unique
  label     String
  type      String
  required  Boolean  @default(false)
  order     Int      @default(0)
  options   String?
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

// ---------------------------------------------------------------------------
// Product catalog
// ---------------------------------------------------------------------------

model ProductCategory {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  position  Int      @default(0)
  createdAt DateTime @default(now())

  products Product[]

  @@index([position])
}

model Product {
  id         String   @id @default(cuid())
  name       String
  categoryId String
  unitCost   Float
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  category  ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  giftLines GiftLine[]

  @@index([categoryId])
}

// ---------------------------------------------------------------------------
// Creators
// ---------------------------------------------------------------------------

model Creator {
  id            String   @id @default(cuid())
  name          String
  niche         String[]
  email         String?  @unique
  phone         String?  @unique
  gender        String?
  shopifyRegistered Boolean?
  customFields  Json?
  followers     Int?
  engagementRate Float?
  notes         String?
  createdById   String?
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Legacy free-text location/type columns (back-filled into FKs then dropped)
  city        String?
  country     String?
  creatorType String?

  countryId     String?
  cityId        String?
  creatorTypeId String?
  countryRef     Country?     @relation(fields: [countryId], references: [id])
  cityRef        City?        @relation(fields: [cityId], references: [id])
  creatorTypeRef CreatorType? @relation(fields: [creatorTypeId], references: [id])

  approvalStatus ApprovalStatus?
  reviewedById   String?
  reviewComment  String?
  reviewedAt     DateTime?
  reviewedBy     User? @relation("CreatorReviewer", fields: [reviewedById], references: [id])

  primaryProfileId String?  @unique
  primaryProfile   PlatformProfile? @relation("PrimaryProfile", fields: [primaryProfileId], references: [id])

  profiles             PlatformProfile[]
  ownerships           CreatorOwnership[]
  engagements          Engagement[]
  activityLogs         ActivityLog[]
  availabilityRequests AvailabilityRequest[]

  createdBy User? @relation("CreatorCreator", fields: [createdById], references: [id])

  @@index([name])
  @@index([deletedAt])
  @@index([approvalStatus])
  @@index([cityId])
}

model PlatformProfile {
  id          String   @id @default(cuid())
  creatorId   String
  platform    Platform
  handle      String
  normalizedHandle String
  url         String
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())

  creator       Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  primaryOfCreator Creator? @relation("PrimaryProfile")

  @@unique([platform, normalizedHandle])
  @@index([creatorId])
}

model CreatorOwnership {
  id        String   @id @default(cuid())
  creatorId String
  userId    String
  teamId    String
  createdAt DateTime @default(now())

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([creatorId, userId, teamId])
  @@index([teamId])
}

// ---------------------------------------------------------------------------
// Pipeline
// ---------------------------------------------------------------------------

model Stage {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  order       Int      @default(0)
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())

  engagements    Engagement[]
  pipelineConfigs PipelineConfig[]
}

model PipelineConfig {
  id          String @id @default(cuid())
  teamId      String
  stageId     String
  order       Int    @default(0)
  isCompleted Boolean @default(false)

  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  stage Stage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([teamId, stageId])
}

// ---------------------------------------------------------------------------
// Gift statuses (admin-managed workflow rows, cloned from the Stages pattern;
// transitions never hardcode status names — behavior comes from flags)
// ---------------------------------------------------------------------------

model GiftStatus {
  id                String           @id @default(cuid())
  key               String           @unique
  label             String
  position          Int              @default(0)
  approvalRole      GiftApprovalRole @default(NONE)
  isDraft           Boolean          @default(false)
  isRejection       Boolean          @default(false)
  grantCredit       Boolean          @default(false)
  spawnDeliverables Boolean          @default(false)
  warehouseStep     Boolean          @default(false)
  createdAt         DateTime         @default(now())

  gifts Gift[]

  @@index([position])
}

// ---------------------------------------------------------------------------
// Engagements, Deliverables, Gifts
// ---------------------------------------------------------------------------

model Engagement {
  id        String   @id @default(cuid())
  creatorId String
  teamId    String
  title     String
  dealType  DealType
  amount    Float?
  couponCode String?
  commissionPercent Float?
  currency  Currency
  stageId   String
  createdById String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  completedAt DateTime?

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  team    Team    @relation(fields: [teamId], references: [id])
  stage   Stage   @relation(fields: [stageId], references: [id])
  createdBy User  @relation("EngagementCreator", fields: [createdById], references: [id])

  deliverables Deliverable[]
  gifts        Gift[]

  @@index([creatorId])
  @@index([teamId])
  @@index([stageId])
}

model Deliverable {
  id            String   @id @default(cuid())
  engagementId  String
  giftId        String?
  title         String
  type          String
  dueDate       DateTime
  status        DeliverableStatus @default(PENDING)
  postedUrl     String?
  postedDate    DateTime?
  submittedById String?
  submittedAt   DateTime?
  reviewedById  String?
  reviewComment String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  gift       Gift?      @relation(fields: [giftId], references: [id], onDelete: SetNull)
  submittedBy User?     @relation("DeliverableSubmitter", fields: [submittedById], references: [id])
  reviewedBy  User?     @relation("DeliverableReviewer", fields: [reviewedById], references: [id])

  @@index([engagementId])
  @@index([status])
  @@index([giftId])
}

model Gift {
  id              String    @id @default(cuid())
  orderNumber     Int       @unique @default(autoincrement())
  engagementId    String
  statusId        String
  requestedById   String
  requestedAt     DateTime  @default(now())
  isException     Boolean   @default(false)
  exceptionReason String?
  approvedById    String?
  approvedAt      DateTime?
  trackingNumber  String?
  carrier         String?
  dispatchedAt    DateTime?
  deliveredAt     DateTime?
  shippingAddress String?
  orderTotal      Float     @default(0)
  currency        Currency  @default(EGP)
  agreedBudget    Float?
  commissionRate  Float?
  couponCode      String?
  createdAt       DateTime  @default(now())

  status     GiftStatus @relation(fields: [statusId], references: [id], onDelete: Restrict)
  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  requestedBy User      @relation("GiftRequester", fields: [requestedById], references: [id])
  approvedBy  User?     @relation("GiftApprover", fields: [approvedById], references: [id])

  lines        GiftLine[]
  deliverables Deliverable[]

  @@index([engagementId])
  @@index([statusId, requestedAt])
}

model GiftLine {
  id            String  @id @default(cuid())
  giftId        String
  productId     String?
  productName   String
  productDescription String?
  unitCost      Float   @default(0)
  quantity      Int     @default(1)
  lineTotal     Float   @default(0)

  gift    Gift     @relation(fields: [giftId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([giftId])
}

// ---------------------------------------------------------------------------
// Activity Log
// ---------------------------------------------------------------------------

model ActivityLog {
  id          String   @id @default(cuid())
  creatorId   String
  kind        ActivityKind
  type        ActivityType
  summary     String
  description String?
  authorId    String?
  loggedAt    DateTime @default(now())
  createdAt   DateTime @default(now())

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  author  User?   @relation("ActivityAuthor", fields: [authorId], references: [id])

  attachments Attachment[]

  @@index([creatorId, loggedAt])
}

model Attachment {
  id            String   @id @default(cuid())
  activityLogId String
  filename      String
  mimeType      String
  size          Int
  path          String
  createdAt     DateTime @default(now())

  activityLog ActivityLog @relation(fields: [activityLogId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Availability Request
// ---------------------------------------------------------------------------

model AvailabilityRequest {
  id                String   @id @default(cuid())
  creatorId         String
  requestingTeamId  String
  requestingUserId  String
  owningTeamId      String
  note              String?
  status            AvailRequestStatus @default(PENDING_PRE_APPROVAL)
  preApprovedById   String?
  releasedById      String?
  rejectedById      String?
  rejectReason      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  resolvedAt        DateTime?

  creator        Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  requestingTeam Team    @relation("RequestingTeam", fields: [requestingTeamId], references: [id])
  owningTeam     Team    @relation("OwningTeam", fields: [owningTeamId], references: [id])
  requester      User    @relation("Requester", fields: [requestingUserId], references: [id])
  preApprovedBy  User?   @relation("PreApprover", fields: [preApprovedById], references: [id])
  releasedBy     User?   @relation("ReleaseApprover", fields: [releasedById], references: [id])
  rejectedBy     User?   @relation("RequestRejector", fields: [rejectedById], references: [id])

  @@index([creatorId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id     String   @id @default(cuid())
  userId String
  type   NotificationType
  title  String
  body   String?
  link   String?
  readAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

// ---------------------------------------------------------------------------
// Workspace Settings
// ---------------------------------------------------------------------------

model WorkspaceSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}